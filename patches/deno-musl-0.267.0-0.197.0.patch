diff -ru a/deno_node/ops/process.rs b/deno_node/ops/process.rs
--- a/deno_node/ops/process.rs	2026-10-25 20:28:55
+++ b/deno_node/ops/process.rs	2026-10-25 20:29:54
@@ -118,6 +118,9 @@
     if argv.is_null() || argc <= 0 {
       return;
     }
+    // musl exposes no glibc-compatible argv layout to inspect here.
+    #[cfg(target_env = "musl")]
+    return;
     // SAFETY: argc and argv are provided by the OS at process init and are valid.
     let info = unsafe { compute_argv_info(argc as usize, argv) };
     let _ = ARGV_INFO.set(info);
